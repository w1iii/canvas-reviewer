# Database
DATABASE_URL=sqlite+aiosqlite:///./canvas_reviewer.db

# Redis
REDIS_URL=redis://localhost:6379

# AI Provider: "ollama", "groq", "gemini", "none"
AI_PROVIDER=ollama

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Groq (free cloud)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Gemini (free cloud)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Freemium
FREE_COURSE_LIMIT=3

# Output
OUTPUT_DIR=./output

# Encryption key (auto-generated if empty)
ENCRYPTION_KEY=
